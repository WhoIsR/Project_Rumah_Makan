# ──────────────────────────────────────────────────────────
# Production environment template
# Copy to .env on your server and fill in real values.
# NEVER commit the actual .env file to version control.
# ──────────────────────────────────────────────────────────

APP_NAME="Rumah Makan"
APP_ENV=production
APP_KEY=                        # Run: php artisan key:generate --show
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ─── Database ────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=db               # Use 127.0.0.1 on a bare VPS; 'db' inside Docker
DB_PORT=3306
DB_DATABASE=rumah_makan
DB_USERNAME=laravel
DB_PASSWORD=             # STRONG random password

# Optional — only required if using a DB URL instead of individual values
# DB_URL=mysql://user:password@host:3306/dbname

# ─── Session / Cache / Queue ─────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=your-domain.com
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── Mail ────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=smtp.mailprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── AWS S3 (optional for file storage) ──────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
